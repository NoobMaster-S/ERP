# ==============================================================================
# GLOBAL & BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Django Core
DEBUG=True
SECRET_KEY=erp-insecure-development-secret-key-change-in-production-123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# PostgreSQL Database Configuration
DB_NAME=erp_platform
DB_USER=erp_user
DB_PASSWORD=erp_password_secret
DB_HOST=localhost
DB_PORT=5432

# JWT Security Configuration
JWT_SECRET_KEY=jwt-insecure-secret-key-development-replace-in-production-abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# S3 / Object Storage Configuration
STORAGE_BACKEND=minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=erp-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# ==============================================================================
# ADMIN PANEL (Next.js) ENVIRONMENT CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8000/graphql/
NEXT_PUBLIC_APP_NAME="ERP Platform Admin"

# ==============================================================================
# BUSINESS APP (Flutter) ENVIRONMENT CONFIGURATION
# ==============================================================================
FLUTTER_API_BASE_URL=http://10.0.2.2:8000/graphql/
